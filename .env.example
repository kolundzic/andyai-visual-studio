# AndyAI Visual Studio — environment template
# Copy this file to .env.local for local development.

# Data mode:
# - mock: always use local mock adapter
# - supabase: use live Supabase client when configured, with safe fallback to mock
AVS_DATA_MODE=mock
NEXT_PUBLIC_AVS_DATA_MODE=mock

# Supabase public project settings
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side privileged key for future admin/service tasks.
# Do not expose this in the browser.
SUPABASE_SERVICE_ROLE_KEY=
